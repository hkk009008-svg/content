{
  "name": "cinema-production-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "mkdir -p ../logs/ui/product-unification && vitest run a11y --reporter=verbose > ../logs/ui/product-unification/a11y.txt 2>&1; status=$?; cat ../logs/ui/product-unification/a11y.txt; exit $status"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
