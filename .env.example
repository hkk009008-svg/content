# ---------------------------------------------------------------------------
# Cinema Pipeline — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
#
# This list is authoritative — every variable read by config/settings.py
# appears below. The e2e tests require COMFYUI_SERVER_URL + at least one
# video API key + ELEVENLABS_API_KEY for the audio path.
# ---------------------------------------------------------------------------

# ComfyUI (set automatically by setup_runpod.sh, or point to remote instance)
COMFYUI_SERVER_URL=http://127.0.0.1:8188
# Optional bearer token for an authenticated ComfyUI reverse proxy.
COMFYUI_API_KEY=

# --- LLM providers (the cinema pipeline needs at least Anthropic + OpenAI) ---

# Anthropic — Claude (script generation, judging, chief director)
ANTHROPIC_API_KEY=

# OpenAI — GPT-4o (script generation, judging, scene decomposition)
OPENAI_API_KEY=

# Google AI Studio — Gemini (opt-in for the LLM roster; default rosters are
# Anthropic + OpenAI). Also doubles as a video credential: GEMINI_OMNI (the
# Google-first primary video engine, see below) tries GOOGLE_API_KEY first
# and falls back to this key.
GEMINI_API_KEY=

# --- Video Generation APIs (need at least one) ---
# GEMINI_OMNI is the Google-first primary video engine for every shot type
# (config/prompts/pipeline_context.md); everything else here is a fallback in
# the cascade.

# Google — primary video credential. Used by GEMINI_OMNI (Gemini Developer
# API — tries this key first, GEMINI_API_KEY above second) and by Veo's
# Gemini-fallback path when Vertex AI (GOOGLE_CLOUD_* below) isn't
# configured. Veo does NOT accept GEMINI_API_KEY as a substitute for this.
GOOGLE_API_KEY=

# FAL.ai — the single highest-leverage optional key: it drives most of the
# fallback video cascade (Kling v3 Pro, Seedance, the Veo/Runway FAL proxies),
# the FAL-hosted lip-sync engines (MuseTalk, OmniHuman, LatentSync, sync.so),
# LTX's FAL profile, and FLUX image fallbacks/upscale (SeedVR2).
FAL_KEY=

# LTX — native lightweight video generation (ltx_native.py; signed input
# upload + recoverable async-v2 job polling; the ltx-2-3-pro profile accepts
# only 6/8/10-second clips, 6s default). FAL_KEY above also reaches LTX's
# FAL-proxied profile.
LTX_API_KEY=

# Kling — legacy NATIVE (v1.6 JWT) route only, fallback-only since 2026-07-11.
# The more commonly used "Kling v3 Pro" fallback is FAL-proxied and reads
# FAL_KEY above, not these two.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Runway — Gen-4 Turbo video generation AND the Act-Two talking-head
# performance-capture transfer (performance/act_two.py migrated off the
# retired Act-One); the same credential drives both.
RUNWAYML_API_SECRET=

# --- Audio Generation ---

# ElevenLabs — TTS narration + dialogue (required for the audio path)
ELEVENLABS_API_KEY=

# Cartesia — Sonic 2 alternate TTS provider (optional)
CARTESIA_API_KEY=

# Stability AI — Stable Audio 2 alt foley/BGM (optional)
STABILITY_API_KEY=

# Suno — alternate BGM provider (default is FAL Stable Audio). SUNO_TOKEN is
# accepted as a legacy alias if this is unset (checked in that order).
SUNO_API_KEY=
SUNO_API_BASE=https://api.sunoapi.org

# --- Performance capture ---

# Viggle — motion-transfer performance capture (Mode A only — needs driving
# video). Currently cataloged KNOWN_BROKEN: the adapter targets the wrong
# adapter was rewritten to the official apis.viggle.ai/v1/renders contract and
# uncontained 2026-08-01 (ADR-082). Catalog state is LIMITED, not SUPPORTED:
# contract-correct and unit-tested, but never exercised against the live API,
# so the first real render is also the first live verification.
VIGGLE_API_KEY=

# --- Vertex AI (Veo's preferred backend — the only one with native audio) ---
# Also requires gcloud Application Default Credentials alongside the project
# ID (`gcloud auth application-default login`, or GOOGLE_APPLICATION_CREDENTIALS
# pointing at a service-account key) — standard gcloud/ADC setup, not its own
# config/settings.py field. Veo falls back to the GOOGLE_API_KEY path above
# (no native audio) when Vertex AI init fails.

# Google Cloud project ID hosting the Vertex AI workloads
GOOGLE_CLOUD_PROJECT=

# Vertex AI region (defaults to us-central1 if unset)
GOOGLE_CLOUD_LOCATION=us-central1

# --- Research / Discovery ---

# Firecrawl — web scraping for trending-topic research
FIRECRAWL_API_KEY=

# Tavily — web search for trending-topic research
TAVILY_API_KEY=

# --- Infrastructure tuning (optional — safe defaults if unset) ---

# SQLite cost-tracker DB path (defaults to data/experiments.db)
EXPERIMENTS_DB_PATH=

# Content-hash cache for Mode-B driving-video synthesis (SadTalker via
# ComfyUI — the only current provider; see performance/driving_video.py)
PERFORMANCE_CACHE_DIR=

# Frame-pair sample count for performance.motion_gate.score_motion_fidelity
MOTION_GATE_SAMPLES=8

# DeepFace identity-embedding backbone (defaults to GhostFaceNet). Every
# calibrated identity threshold in identity/types.py assumes GhostFaceNet's
# score distribution — changing this invalidates those thresholds until
# recalibrated (identity/validator.py).
IDENTITY_EMBED_MODEL=

# Only consulted when IDENTITY_EMBED_MODEL=AdaFace (ADR-078). The adapter is
# vendored, so it needs a local checkpoint — fetch one with
# scripts/download_adaface_ckpt.py, or point CKPT at an existing file. Leaving
# CKPT empty while selecting AdaFace fails LOUD at startup rather than
# silently skipping identity validation. ARCH defaults to ir_101.
IDENTITY_ADAFACE_CKPT=
IDENTITY_ADAFACE_ARCH=

# --- Web server (optional — safe defaults if unset) ---

# Bind address for `python web_server.py`. This unauthenticated application is
# intentionally loopback-only; non-loopback values fail startup validation.
WEB_BIND_HOST=127.0.0.1

# CORS allowlist — comma-separated origins permitted to call the API.
# Default (unset) is localhost dev origins only:
#   http://localhost:8080,http://localhost:5173
# Wildcard origins are rejected. Add only explicit local development origins.
WEB_CORS_ORIGINS=
